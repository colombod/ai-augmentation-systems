// 04-retry-with-fallback.dot -- retry ladder attributes alongside a drawn
// corrective edge (max_retries, retry_target).
//
// Substantially SIMPLIFIED from microsoft/amplifier-bundle-attractor's own
// examples/pipelines/04-retry-with-fallback.dot (fetched 2026-08-10, ~250
// lines) -- see ../../.delivery/decisions/ADR-019-example-portability-policy.md
// and this project's own honesty precedent (spec-conformance.md's "1 of 4,
// not 2 of 4" table). The original demonstrates a full explicit-renegotiation
// pattern: a budget-exhaustion trigger, a pipeline-enforced disclosure
// artifact (renegotiation.md, structurally validated by its own gate), and a
// relaxed fallback path with a different, weaker evidence gate. That full
// pattern is real, valuable doctrine and is NOT reproduced here in this
// pass -- read the original for it. This adaptation keeps only the smaller,
// verified-safe lesson: `max_retries`/`retry_target` stated explicitly on a
// node, alongside the drawn corrective edge that is spec section 3.3's
// actually-active routing mechanism (see reference/routing-reference.md and
// engine-semantics.md's Retry section for why the graph-level/node-level
// retry ladder and a drawn edge are two different things, consulted at two
// different points).
//
// Run it: node <plugin-root>/dist/attractor.js run 04-retry-with-fallback.dot \
//           --cwd /tmp/some-dir --stub --param goal="a validated regex"

digraph RetryWithFallback {
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    done  [shape=Msquare,  label="Done"]

    plan [
        label="Plan",
        prompt="Plan the approach for: ${goal}"
    ]

    // max_retries/retry_target are stated explicitly (belt-and-suspenders,
    // matching amplifier's own "demonstrate the retry-ladder API" framing)
    // even though the drawn edge below is the mechanism actually exercised
    // when this graph runs -- see engine-semantics.md's Retry section.
    implement [
        label="Implement",
        prompt="Attempt: ${goal}. (Informational -- the gate below is authoritative.)",
        max_retries=3,
        retry_target="plan"
    ]

    // Fails twice, passes the third visit -- so the retry edge actually fires
    // before the pass edge does.
    validate_gate [
        shape=parallelogram,
        label="Validate",
        goal_gate=true,
        retry_target="implement",
        tool_command="mkdir -p .attractor-demo; c=$(( $(cat .attractor-demo/count-04 2>/dev/null || echo 0) + 1 )); echo $c > .attractor-demo/count-04; [ \"$c\" -ge 3 ] && printf gate_pass || printf gate_fail"
    ]

    start -> plan -> implement -> validate_gate
    validate_gate -> done       [label="pass",  condition="context.tool.last_line=gate_pass"]
    validate_gate -> implement  [label="retry", condition="context.tool.last_line=gate_fail"]
}
