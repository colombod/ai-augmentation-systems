// 03-conditional-routing.dot -- evidence-based routing with tool gates.
//
// Adapted from microsoft/amplifier-bundle-attractor's own
// examples/pipelines/03-conditional-routing.dot (fetched 2026-08-10) -- see
// ../../.delivery/decisions/ADR-019-example-portability-policy.md. THE SHAPE
// is unchanged: implement -> test -> gate, with gate routing to done (pass)
// or fix (fail), and fix looping back to test. The illustrative pytest task
// is replaced with a deterministic counter (see 00-convergence-loop.dot).
//
// ROUTING PATTERN (same lesson as the original): the gate runs a real check
// and prints a token as its last stdout line; edges condition on that token
// via context.tool.last_line. This is the correct pattern -- NOT shape=diamond
// with outcome= conditions (the conditional handler always returns SUCCESS,
// so outcome-based edges from a diamond are dead; see reference/routing-
// reference.md).
//
// Run it: node <plugin-root>/dist/attractor.js run 03-conditional-routing.dot \
//           --cwd /tmp/some-dir --stub --param goal="build a small service"

digraph ConditionalRouting {
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    done  [shape=Msquare, label="Done"]

    implement [
        label="Implement",
        prompt="Advance the work toward: ${goal}. (Informational -- the gate below is authoritative.)"
    ]

    test [
        label="Run Tests",
        prompt="Describe the current state of the work. (Informational -- the gate below is authoritative.)"
    ]

    // Evidence gate -- fails the first visit, passes the second, so both the
    // pass edge and the fail-then-fix-then-retry edge are actually exercised.
    gate [
        shape=parallelogram,
        label="Tests Pass?",
        tool_command="mkdir -p .attractor-demo; c=$(( $(cat .attractor-demo/count-03 2>/dev/null || echo 0) + 1 )); echo $c > .attractor-demo/count-03; [ \"$c\" -ge 2 ] && printf pass || printf fail"
    ]

    fix [
        label="Fix Issues",
        prompt="The tests failed. Fix the issues identified by the tests."
    ]

    start -> implement -> test -> gate

    gate -> done [label="pass", condition="context.tool.last_line=pass", weight=10]
    gate -> fix  [label="fail", condition="context.tool.last_line=fail", weight=5]

    fix -> test
}
