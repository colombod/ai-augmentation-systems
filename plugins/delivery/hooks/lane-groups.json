{
  "read": [
    { "first": "ls" },
    { "first": "cat" },
    { "first": "head" },
    { "first": "tail" },
    { "first": "grep" },
    { "first": "rg", "flags_none": ["--pre", "--pre-glob"] },
    { "first": "find", "flags_none": ["-exec", "-execdir", "-delete", "-fprint", "-fprint0", "-fprintf", "-ok", "-okdir"] },
    { "first": "wc" },
    { "first": "diff" },
    { "first": "jq" },
    { "first": "cut" },
    { "first": "tr" },
    { "first": "pwd" },
    { "first": "echo" },
    { "first": "date" },
    { "first": "which" },
    { "first": "test" },
    { "first": "true" },
    { "first": "cd" },
    { "first": "basename" },
    { "first": "dirname" },
    { "first": "realpath" },
    { "first": "stat" },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/team-status.js" },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/prepare-role.js" },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/warnings.js", "sub": ["list"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/surface.js", "sub": ["check", "show"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/ready.js", "flags_none": ["--record", "--owner-record"], "native_allow": false },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/evidence.js", "sub": ["list", "check"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/goal.js", "sub": ["show"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/owner-queue.js", "sub": ["list"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/reality-check.js", "sub": ["show"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/wave.js", "sub": ["show"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/plan.js", "sub": ["budget", "select"], "flags_none": ["--record"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/usage.js", "sub": ["show"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/assumptions.js", "sub": ["list"] }
  ],
  "git-read": [
    { "first": "git", "sub": ["status", "log", "diff", "show", "rev-parse", "remote -v", "remote show", "remote get-url", "blame", "describe", "tag -l", "tag --list", "stash list", "worktree list", "merge-base", "shortlog", "cat-file", "rev-list"], "flags_none": ["--output", "-o", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack"] },
    { "first": "git", "sub": ["ls-files"], "flags_none": ["--output", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack"] },
    { "first": "git", "sub": ["branch"], "flags_any": ["--list", "-l"], "flags_none": ["--output", "-o", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack", "-D", "-d", "-m", "-M", "--delete", "--move", "-c", "-C", "--copy", "-f", "--force", "-u", "--set-upstream-to", "--unset-upstream", "--edit-description", "-t", "--track", "--no-track"] },
    { "first": "git", "sub": ["branch"], "flags_any": ["-a", "--all", "-r", "--remotes", "-v", "-vv", "--verbose", "--show-current", "--contains", "--no-contains", "--merged", "--no-merged"], "no_positional": true, "value_flags": ["--contains", "--no-contains", "--merged", "--no-merged", "--points-at", "--sort", "--format"], "flags_none": ["--output", "-o", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack", "-D", "-d", "-m", "-M", "--delete", "--move", "-c", "-C", "--copy", "-f", "--force", "-u", "--set-upstream-to", "--unset-upstream", "--edit-description", "-t", "--track", "--no-track"] }
  ],
  "git-write-project": [
    { "first": "git", "sub": ["add", "commit", "push", "pull", "fetch", "checkout", "switch", "restore", "stash", "merge", "cherry-pick", "reset"], "scope": "project", "flags_none": ["--output", "-o", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack"] },
    { "first": "git", "sub": ["rebase"], "scope": "project", "flags_none": ["--output", "-o", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack", "-x"] }
  ],
  "git-write-product": [
    { "first": "git", "sub": ["add", "commit", "push", "pull", "fetch", "checkout", "switch", "restore", "stash", "merge", "cherry-pick", "reset", "worktree"], "scope": "product", "flags_none": ["--output", "-o", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack"] },
    { "first": "git", "sub": ["rebase"], "scope": "product", "flags_none": ["--output", "-o", "--upload-pack", "--exec", "--ext-diff", "--textconv", "--receive-pack", "-x"] }
  ],
  "gh-read": [
    { "first": "gh", "sub": ["pr view", "pr list", "pr checks", "pr diff", "pr status", "issue view", "issue list", "run view", "run list", "run watch", "repo view", "release list", "release view"] }
  ],
  "gh-write": [
    { "first": "gh", "sub": ["pr create", "pr edit", "pr comment", "pr merge", "pr ready", "pr review", "issue comment", "release create", "workflow run"] }
  ],
  "bd-read": [
    { "first": "bd", "sub": ["list", "show", "ready", "prime", "where", "dep list", "dep tree", "dep cycles", "label list", "label list-all", "stats", "help", "comments list"] }
  ],
  "bd-notes": [
    { "first": "bd", "sub": ["update"], "flags_any": ["--append-notes", "--notes"], "flags_none": ["--parent", "--claim", "--status", "--assignee", "--title", "--type", "--priority", "--add-label", "--remove-label", "--metadata", "--description", "--design", "--acceptance", "-s", "-a", "-p", "-t", "-d", "-l"] },
    { "first": "bd", "sub": ["comments add", "comment add"] }
  ],
  "bd-claim": [
    { "first": "bd", "sub": ["update"], "flags_any": ["--claim"], "flags_none": ["--parent", "--title", "--type", "--priority", "--add-label", "--remove-label", "--metadata", "--description", "--design", "--acceptance", "-p", "-t", "-d", "-l"] },
    { "first": "bd", "sub": ["update"], "flags_any": ["--status", "--assignee", "-s", "-a"], "flags_none": ["--parent", "--title", "--type", "--priority", "--add-label", "--remove-label", "--metadata", "--description", "--design", "--acceptance", "-p", "-t", "-d", "-l"] },
    { "first": "bd", "sub": ["close", "assign", "reopen"] }
  ],
  "bd-create-child": [
    { "first": "bd", "sub": ["create"], "flags_any": ["--parent"], "flags_none": ["--id"] }
  ],
  "bd-structure": [
    { "first": "bd", "sub": ["create", "dep add", "dep remove", "dep relate", "dep unrelate", "label add", "label remove", "label propagate", "delete", "update", "assign", "tag", "todo", "import", "reopen", "duplicates", "link", "duplicate", "supersede", "rename", "rename-prefix", "set-state", "mol", "epic", "swarm"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/materialise.js" }
  ],
  "operator-read": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/operator.js", "sub": ["verify", "show", "pending", "sync", "ledger", "find", "problems", "refresh"], "flags_none": ["--transcript", "--session"] }
  ],
  "operator-write": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/operator.js", "sub": ["record", "delegate", "decide", "revoke", "ack", "ask", "withdraw", "answer", "ratify", "rehost", "quarantine", "repair", "publish"], "flags_none": ["--transcript", "--session"] }
  ],
  "acceptance": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/warnings.js", "sub": ["ack"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/ready.js" },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/evidence.js", "sub": ["add", "state", "waive", "cut"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/reality-check.js", "sub": ["plan", "refine"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/wave.js", "sub": ["plan", "close"] },
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/plan.js", "sub": ["select"] }
  ],
  "reality-check": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/reality-check.js", "sub": ["run-record"] }
  ],
  "assumptions": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/assumptions.js", "sub": ["add", "observe", "refute", "ack", "reopen", "retire", "relink"] }
  ],
  "probe": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/assumptions.js", "sub": ["probe"] }
  ],
  "goal-write": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/goal.js", "sub": ["ask", "set", "pause"] }
  ],
  "owner-queue": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/owner-queue.js", "sub": ["add", "done"] }
  ],
  "judge": [
    { "first": "node", "arg_prefix": "${CLAUDE_PLUGIN_ROOT}/scripts/judge.js", "sub": ["ask", "questions", "stats"] }
  ],
  "any": [
    { "first": "*" }
  ]
}
