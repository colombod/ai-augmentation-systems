{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/record-invocation.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Skill|Agent|mcp__Claude_Browser__computer|mcp__Claude_Code_iOS_Simulator__control)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/record-invocation.js"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Skill|Agent|Write|Edit|NotebookEdit|mcp__Claude_Browser__computer|mcp__Claude_Code_iOS_Simulator__control)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/record-invocation.js"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
