{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/role-session-start.js"], "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/role-prompt-submit.js"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent|Write|Edit|NotebookEdit|mcp__Claude_Browser__computer|mcp__Claude_Code_iOS_Simulator__control",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/record-invocation.js"] }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/leak-post-push.js"], "timeout": 15 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Skill|Agent|Write|Edit|NotebookEdit|mcp__Claude_Browser__computer|mcp__Claude_Code_iOS_Simulator__control",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/record-invocation.js"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit|Bash|Monitor|PowerShell|mcp__.*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/role-lane.js"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit|Bash|Monitor|PowerShell|mcp__.*(github|gitlab|git).*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/leak-guard.js"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|Monitor|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bd-guard-hook.js"], "timeout": 15 }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ask-guard.js"], "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/claim-stop.js"], "timeout": 15 }
        ]
      }
    ]
  }
}
